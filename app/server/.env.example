# Bridge server config — copy to .env and fill in.
# The real .env is git-ignored; never commit personal credentials.

# OpenRouter (required for AI answers) — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Local Parakeet speech-to-text sidecar (optional). Leave blank to use the
# browser's Web Speech engine instead.
# LOCAL_STT_URL=http://127.0.0.1:8123/transcribe

# GitHub OAuth App client id for device-flow login (public; safe to set).
# GITHUB_OAUTH_CLIENT_ID=

# Written automatically at runtime when you connect GitHub — do NOT fill in
# or commit these; they are personal credentials.
# GITHUB_TOKEN=
# GITHUB_LOGIN=

NOTES_DIR=../notes
PORT=4317
