{
  "name": "bridge",
  "private": true,
  "version": "0.2.0",
  "description": "Bridge — a multi-agent command center, packaged as a macOS app.",
  "main": "app/electron/main.js",
  "scripts": {
    "server": "node app/server/server.js",
    "qa:new": "bash scripts/qa-new-project.sh",
    "stt": "bash -c 'export HF_HUB_CACHE=\"$PWD/build/hf-cache/hub\" && source app/stt/.venv/bin/activate && python app/stt/parakeet_server.py'",
    "electron": "electron .",
    "dev": "electron .",
    "fetch:python": "bash build/fetch-python.sh",
    "prepare:stt": "bash build/prepare-stt.sh",
    "build:mac": "npm run fetch:python && npm run prepare:stt && electron-builder --mac --arm64",
    "build:mac:arm64": "npm run fetch:python && npm run prepare:stt && electron-builder --mac --arm64",
    "build:mac:x64": "npm run fetch:python && electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.machinarii.bridge",
    "productName": "Bridge",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "app/electron/**/*",
      "app/server/**/*",
      "app/renderer/**/*",
      "!app/server/node_modules/.cache/**/*",
      "!app/stt/.venv/**/*",
      "!app/state/**/*",
      "!app/server/.env"
    ],
    "extraResources": [
      {
        "from": "app/stt",
        "to": "stt",
        "filter": [
          "**/*.py",
          "requirements.txt",
          "README.md"
        ]
      },
      {
        "from": "build/python-${arch}/python",
        "to": "python"
      },
      {
        "from": "build/site-packages-${arch}",
        "to": "stt-packages"
      },
      {
        "from": "build/hf-cache",
        "to": "hf-cache"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "935434BZ22"
      },
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Bridge uses the microphone for push-to-talk voice prompts to your agents."
      }
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "asar": false
  },
  "dependencies": {
    "express": "^4.22.2"
  }
}
